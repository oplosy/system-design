{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": { "includes": ["core/**", "server/**", "mcp/**", "cli/**", "src/**", "e2e/**"] },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        // An effect that runs on a chosen trigger or reads a ref says so with a biome-ignore and its reason.
        "useExhaustiveDependencies": "error"
      },
      "style": {
        // Ids in a checked design are known to exist; schema validation is what guarantees it.
        "noNonNullAssertion": "off",
        // Selectors stay next to the thing they style, not in specificity order.
        "noDescendingSpecificity": "off"
      },
      "complexity": {
        // `(e.preventDefault(), close())` in a one-line handler is the house style.
        "noCommaOperator": "off",
        // Reduced motion has to beat every animation.
        "noImportantStyles": "off"
      },
      "suspicious": {
        // `void (x = y)` marks an arrow that assigns on purpose.
        "noAssignInExpressions": "off",
        "useIterableCallbackReturn": "off",
        // Drawn paths and steps have no identity of their own, and their order never changes under them.
        "noArrayIndexKey": "off",
        // ${NAME} in MCP configs is a feature, not a mistake.
        "noTemplateCurlyInString": "off",
        // Shape coordinates, not math constants.
        "noApproximativeNumericConstant": "off"
      },
      "a11y": {
        // Dialogs and menus move focus to their first field; the axe browser tests cover them.
        "noAutofocus": "off",
        // role="radio" on a button is the segmented control; a native input can't be drawn this way.
        "useSemanticElements": "off",
        // Mouse-only handlers say at the element where their keyboard path is, with a biome-ignore.
        "noStaticElementInteractions": "error",
        "useFocusableInteractive": "error",
        "useKeyWithClickEvents": "error"
      }
    }
  }
}
