    {
      "id": "requirements",
      "title": "Requirements and clients",
      "summary": "500M users, 200M daily active. Reads outnumber writes about 100 to 1, so the read path drives the design.",
      "seen": true
    },
    {
      "id": "edge",
      "title": "Edge: DNS, CDN, WAF, API gateway",
      "summary": "Every request enters through one guarded door. Static media never reaches our servers.",
      "seen": true
    },
    {
      "id": "core",
      "title": "Core services and their databases",
      "summary": "Split users and tweets into services that own their data.",
      "seen": false
    },
    {
      "id": "media",
      "title": "Media storage",
      "summary": "Images and videos go to object storage and are served through the CDN.",
      "seen": false
    },
    {
      "id": "timeline",
      "title": "Home timeline with fan-out",
      "summary": "Precompute each user's timeline when a tweet is posted, so reading it is one cache lookup.",
      "seen": false
    },
    {
      "id": "search",
      "title": "Search",
      "summary": "A separate search index fed by the same tweet events.",
      "seen": false
    }
