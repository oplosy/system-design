  "decisions": [
    {
      "id": "decision-gateway",
      "title": "One API gateway in front of all services",
      "why": "Auth, rate limiting and routing live in one place instead of in every service.",
      "alternatives": [
        "Clients call services directly",
        "Backend-for-frontend per client"
      ],
      "tradeoffs": "An extra hop and a component that must scale with all traffic.",
      "links": [
        "gateway"
      ],
      "position": {
        "x": 445,
        "y": 486
      },
      "step": "edge"
    },
    {
      "id": "decision-cassandra",
      "title": "Cassandra for tweets",
      "why": "Tweets are write-heavy, append-only and read by (user, time). Cassandra partitions that natively and scales by adding nodes.",
      "alternatives": [
        "Sharded PostgreSQL",
        "DynamoDB"
      ],
      "tradeoffs": "No joins or ad-hoc queries; data is modelled per query.",
      "links": [
        "tweets-db"
      ],
      "position": {
        "x": 685,
        "y": 826
      },
      "step": "core"
    },
    {
      "id": "decision-fanout",
      "title": "Fan-out on write into Redis",
      "why": "Building a timeline at read time means querying hundreds of followees per request. Precomputing makes the hot path one cache read.",
      "alternatives": [
        "Fan-out on read",
        "Materialized view in the database"
      ],
      "tradeoffs": "Writes cost O(followers) and timelines take memory; hence the celebrity exception.",
      "links": [
        "fanout",
        "timelines"
      ],
      "position": {
        "x": 865,
        "y": 1206
      },
      "step": "timeline"
    },
    {
      "id": "decision-search",
      "title": "Separate search index fed by events",
      "why": "Full-text search does not fit Cassandra. Indexing from the event stream keeps the tweet write path fast.",
      "alternatives": [
        "Search directly in the primary database"
      ],
      "tradeoffs": "Search results are eventually consistent, a few seconds behind.",
      "links": [
        "search"
      ],
      "position": {
        "x": 77,
        "y": 1016
      },
      "step": "search"
    }
  ],
  "boundaries": []
