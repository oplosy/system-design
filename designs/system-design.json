  "decisions": [
    {
      "id": "decision-plain-node-http-server-for-prod",
      "title": "Plain node:http server for production instead of keeping Vite",
      "why": "The app could only run inside the Vite dev server. A small node:http server serves dist/ and mounts the same createApi() handler, so dev and prod share one API code path with no new dependency.",
      "alternatives": [
        "Run vite preview with the plugin",
        "Express or Fastify",
        "Package as Electron app"
      ],
      "tradeoffs": "Static serving (types, caching, traversal guard) is hand-written and minimal; no compression or HTTPS. Fine for a local tool bound to 127.0.0.1.",
      "links": [
        "prod-server",
        "design-api",
        "vite-dev"
      ],
      "step": "existing-app-plus-a-production-server-an"
    },
    {
      "id": "decision-version-field-on-design-files-w",
      "title": "Version field on design files with migrate-on-read",
      "why": "Files had no format version, so a future schema change would make old designs fail validation. parseDesign now treats unversioned files as v1, runs migrations up to the current version, and refuses files from a newer version instead of misreading them.",
      "alternatives": [
        "No versioning, keep schema fields optional forever",
        "Separate migration CLI"
      ],
      "tradeoffs": "Files are upgraded only when next written, so the folder can hold mixed versions until then.",
      "links": [
        "store"
      ],
      "step": "existing-app-plus-a-production-server-an"
    },
    {
      "id": "decision-read-terraform-from-terraform-s",
      "title": "Read Terraform from `terraform show -json`, not HCL source",
      "why": "The JSON output is Terraform's stable machine format, carries resolved names, depends_on and (in plans) expression references, and the existing YAML parser already reads JSON, so no new dependency is needed.",
      "alternatives": [
        "Parse .tf files with an HCL parser dependency",
        "Read terraform.tfstate directly"
      ],
      "tradeoffs": "Users must run terraform show -json first; links through skipped resources (service → target group → LB) are not followed yet.",
      "links": [
        "infra-reader"
      ],
      "step": "drift-check-against-compose-kubernetes-a"
    },
    {
      "id": "decision-drift-is-the-import-in-sync-mod",
      "title": "Drift is the import in sync mode, matched by id or label",
      "why": "One code path for import and drift keeps type mapping, link detection and grouping identical; running it on a copy gives the report, running it on the design adds the missing items as one unseen step, so the reviewer stays in control.",
      "alternatives": [
        "Separate diff engine",
        "Store a source address on each part for exact matching"
      ],
      "tradeoffs": "Only reports what the design lacks, not parts the infrastructure dropped; a rename on one side shows up as a new part.",
      "links": [
        "infra-reader",
        "drift-cli"
      ],
      "step": "drift-check-against-compose-kubernetes-a"
    }
  ],
