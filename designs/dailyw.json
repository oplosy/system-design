  "decisions": [
    {
      "id": "decision-native-swift-app-for-macos-inst",
      "title": "Native Swift app for macOS instead of a cross-platform rewrite",
      "why": "WPF cannot run on macOS. A single Swift file needs no dependencies beyond Xcode Command Line Tools and leaves the working Windows version untouched.",
      "alternatives": [
        "Hammerspoon + HTML webview",
        "Shared Tauri/Electron app for both OSes"
      ],
      "tradeoffs": "Two codebases to keep in sync by hand; features must be ported twice. Cannot be compiled or tested from the Windows machine.",
      "links": [
        "mac-app",
        "win-app"
      ],
      "position": {
        "x": 422,
        "y": 320
      },
      "step": "add-native-macos-client-alongside-the-wi"
    },
    {
      "id": "decision-separate-data-per-machine",
      "title": "Separate data per machine",
      "why": "User chose no sync; avoids concurrent-write conflicts on a shared cloud folder. JSON format is identical, so files can be copied manually.",
      "alternatives": [
        "Shared JSON in iCloud/OneDrive/Dropbox folder"
      ],
      "tradeoffs": "Tasks and words do not follow the user between machines.",
      "links": [
        "mac-data",
        "win-data"
      ],
      "position": {
        "x": 15,
        "y": 510
      },
      "step": "add-native-macos-client-alongside-the-wi"
    }
  ],
