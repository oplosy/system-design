{
  "name": "system-design",
  "version": "1.2.0",
  "description": "Local architecture canvas where coding agents add reviewable design steps over MCP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oplosy/system-design.git"
  },
  "homepage": "https://github.com/oplosy/system-design#readme",
  "bugs": "https://github.com/oplosy/system-design/issues",
  "keywords": [
    "architecture",
    "system-design",
    "diagram",
    "mcp",
    "c4",
    "adr",
    "drift"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "system-design": "dist-cli/main.js"
  },
  "files": [
    "dist",
    "dist-cli",
    "templates"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/main.ts",
    "drift": "node cli/drift.ts",
    "share": "node cli/share.ts",
    "mcp": "node mcp/server.ts",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings",
    "build:cli": "vite build --config vite.cli.config.ts",
    "prepare": "npm run build && npm run build:cli",
    "diff": "node cli/diff.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "elkjs": "^0.12.0",
    "roughjs": "^4.6.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "html-to-image": "1.11.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
